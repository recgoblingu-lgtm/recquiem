# Leave blank to keep rooms, accounts, rankings, events, and activity empty until an API is supplied.
VITE_API_BASE_URL=

# Route defaults match the typed API contract in client/src/data/endpoints.ts.
VITE_API_ROOMS_PATH=/rooms
VITE_API_ROOM_PATH=/rooms/:id
VITE_API_ACCOUNTS_PATH=/accounts
VITE_API_ACCOUNT_PATH=/accounts/:id
VITE_API_LEADERBOARD_PATH=/leaderboard
VITE_API_ACTIVITY_PATH=/activity
VITE_API_EVENTS_PATH=/events
VITE_API_SEARCH_PATH=/search
